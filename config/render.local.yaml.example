# Машинные настройки рендера — ПРИМЕР. Скопируй в render.local.yaml (без .example)
# на конкретной машине. render.local.yaml в .gitignore: машинный путь ffmpeg
# не уезжает в git и не ломает другую машину (у Mac свой ffmpeg из PATH).
#
#   cp config/render.local.yaml.example config/render.local.yaml
#
# Файл накладывается ПОВЕРХ общего config/render.yaml через deep-merge — задавай
# ТОЛЬКО отличающиеся ключи, остальное берётся из базового render.yaml.
#
# Тогда `python -m autoreels render` (без флагов --ffmpeg/--encoder) работает как есть.

# --- Системник Windows (AMD, ffmpeg вне PATH) ---
# Профили кодеков в render.yaml уже нацелены на AMF (h264_amf/hevc_amf/av1_amf) — на
# системнике достаточно указать путь к ffmpeg. Профиль по умолчанию — hevc (компактный).
# Автопоиск: если ffmpeg не задан, ищется в PATH и типичных местах (D:\ffmpeg\bin\ffmpeg.exe,
# C:\ffmpeg\bin\, /usr/local/bin). Не найден → внятная ошибка (где искал + как задать).
# ffmpeg: D:\ffmpeg\bin\ffmpeg.exe    # путь к бинарю; на Windows часто вне PATH
# encoder:
#   profile: h264                     # сменить активный профиль (h264 | hevc | av1)

# --- Mac-дев (без AMF): подменить кодек на софтверный, битрейт профиля сохраняется ---
# encoder:
#   profiles:
#     hevc: {codec: libx265}          # deep-merge: меняем только кодек, bitrate из render.yaml

# Альтернатива без файла — переменные окружения (симметрично):
#   RENDER_FFMPEG=D:\ffmpeg\bin\ffmpeg.exe
#   RENDER_PROFILE=h264               # активный кодек-профиль
#   RENDER_ENCODER=libx265            # переопределить кодек (Mac без AMF)
# Приоритет: флаг CLI > env > render.local.yaml > render.yaml.
