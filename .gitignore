# рантайм-данные (PROJECT_STRUCTURE: data/ gitignored)
data/cache/
data/runs/
data/outputs/
# машинно-локальная история прогонов (как transcripts/ — не в git)
data/history.jsonl
# M129: модель лиц YuNet — бинарь, качается командой из config/render.yaml (face_model)
data/models/
# ручной архив старых манифестов на машине (в git — только живые манифесты)
manifests/_archive/

# рабочие папки локального рендера (гигабайты исходников + готовые клипы — НЕ в git;
# манифест в manifests/ остаётся версионируемым — это контракт для машины рендера)
inputs/
inputs-archive/
reels-out/
# текстовые транскрипты для контента (autoreels transcribe). Комментарий — отдельной строкой: git не знает
# комментариев в конце строки, и правило «transcripts/   # …» ничего не игнорировало (M135).
transcripts/
# review files (working material, not shared)
reviews/
# handoff: patches / task files from the assistant for the agent (local only)
handoff/
# M90: clips + plan exported for crosspost (copies/links of reels-out — local only)
export/
# аудио-треки фоновой музыки (бинарь, не в git; кладутся на машину рендера)
music/
# room-tone WAV clips extracted for synthetic tail (runtime, local)
tails/

# per-file кроп-калибровки (calibrations/<sha>.json) ВЕРСИОНИРУЮТСЯ: лёгкий JSON, чтобы
# калибровка с Mac уезжала на системник (git pull) — иначе status там показывает «кропа нет».
# Игнорируем только рабочие кадры-PNG (_work/) — бинарь, регенерируется.
calibrations/_work/

# python
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# секреты провайдеров (Groq / OpenRouter ключи)
.env

# машинные настройки рендера (путь к ffmpeg, кодек энкодера) — накладываются поверх
# общего config/render.yaml через deep-merge. Машинный путь ffmpeg (Windows:
# D:\ffmpeg\bin\ffmpeg.exe) НЕ должен уезжать в git и ломать другую машину. См.
# config/render.local.yaml.example. Общий render.yaml остаётся версионируемым.
config/render.local.yaml

# локальный конфиг харнесса
.claude/

# macOS metadata
.DS_Store
tests/fixtures/clips/
clips*.txt
manifests/*.blocks.*.json
clips-review/
clips_*.txt
review-*.md
reviews/
