+"""M189 (code review of M172–M187 before the release run): every confirmed defect has its test here.
+
+A — the picture: a seam or a masked cut never keeps the same shot on both sides (the tidy spans and the cuts are
+settled before the next seam reads how a window ends); a clause hook shows only its own words."""
+from __future__ import annotations
+
+from autoreels.cloud.plan import ManualPlanParams, PlannedWindow, _tidy_spans, build_manual_plan
+from tests.test_filler_cut import SPEC, _setup
+from tests.test_montage import P as MP, _spec_sents
+from dataclasses import replace
+
+_E = 1e-3
+
+
+def _start(seg) -> str:
+    return "close" if seg.shot == "close" or (seg.close_intervals and seg.close_intervals[0][0] < _E) else "wide"
+
+
+def _end(seg) -> str:
+    if seg.shot == "close":
+        return "close"
+    ci = seg.close_intervals or []
+    return "close" if ci and ci[-1][1] >= (seg.end - seg.start) - _E else "wide"
+
+
+def _seam_pairs(plan):
+    """(shot before, shot after) at every seam between windows and at every masked cut inside one."""
+    out = []
+    segs = [(w, s) for w in plan.windows for s in w.segments()]
+    for (w1, a), (w2, b) in zip(segs, segs[1:]):
+        if w1 is not w2:
+            out.append((_end(a), _start(b)))
+        else:
+            k = w1.segments().index(b)
+            cut = sorted(w1.cuts)[k - 1]
+            if [round(cut[0], 3), round(cut[1], 3)] in [[round(x, 3), round(y, 3)] for x, y in w1.cut_flips]:
+                out.append((_end(a), _start(b)))
+    return out
+
