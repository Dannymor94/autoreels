+    sents, words, smap, align = _setup(spec, [[1.0, 1.6]])
+    big = lambda a, b: 5.0 if a < 2.0 else 0.5            # the filler cut would jump → masked by a switch
+    p = ManualPlanParams(filler_cut=True, jump_mask=True)
+    plan = build_manual_plan(sents, [1, 2, 3], words=words, smap=smap, params=p, align=align, jump=big, breaks=[3])
+    w1, w2 = plan.body
+    assert len(w1.cut_flips) == 1                          # window 1 ends on the other shot than it started
+    pairs = _seam_pairs(plan)
+    assert pairs and all(a != b for a, b in pairs), pairs  # before M189: close → close at the seam
