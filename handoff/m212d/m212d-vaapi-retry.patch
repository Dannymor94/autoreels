+    retry = _vaapi_dropped_frame(Path(out_dir), manifest) if getattr(render_cfg, "vaapi_soft_retry", False) else {}
+    for soft, rids in sorted({v: [r for r, s in retry.items() if s == v] for v in set(retry.values())}.items()):
+        for rid in rids:
