+    cfg = tmp_path / "config" / "r0.yaml"
+    cfg.write_text(cfg.read_text(encoding="utf-8").replace("  min_sec: 25 ", "  min_sec: 5 ")
+                   .replace("  hook_llm: auto ", "  hook_llm: none "), encoding="utf-8")
