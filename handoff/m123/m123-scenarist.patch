+        "units": [{"id": 1, "t0": ss[0][0].t0, "t1": ss[-1][-1].t1, "role": "thesis", "punch": 4,
+                   "refs": f"2.1-{len(ss)}", "topic": 1, "standalone": True, "summary": "тезис"}]}), encoding="utf-8")
+    asked = []
+
+    class Fake:
+        model_id = "fake:scenarist"
